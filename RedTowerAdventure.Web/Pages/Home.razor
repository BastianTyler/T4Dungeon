@page "/"
@inject IJSRuntime JS
@implements IDisposable

<div id="terminal-container"></div>

@code {
    private DotNetObjectReference<Home>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("terminalInterop.init", _dotNetRef);
            await StartGame();
        }
    }

    private async Task StartGame()
    {
        // TODO: hook your game engine output here
        await JS.InvokeVoidAsync("terminalInterop.writeLine", "Welcome to Red Tower Adventure!");
        await JS.InvokeVoidAsync("terminalInterop.writeLine", "Loading...");
    }

    [JSInvokable]
    public async Task OnTerminalInput(string data)
    {
        // TODO: feed input into your game engine
        await JS.InvokeVoidAsync("terminalInterop.write", data);
    }

    public void Dispose() => _dotNetRef?.Dispose();
}