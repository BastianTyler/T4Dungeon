@page "/"
@inject IJSRuntime JSRuntime

<div id="terminal-container" style="width: 800px; height: 450px;"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize the xterm instance
            await JSRuntime.InvokeVoidAsync("setupTerminal", "terminal-container");
            
            // Example of sending data from C# to the terminal
            await JSRuntime.InvokeVoidAsync("writeToTerminal", "T4Dungeon Beta v1.00 Loaded.");
        }
    }
}