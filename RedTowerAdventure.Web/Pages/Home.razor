@page "/"
@inject IJSRuntime JS
@implements IDisposable
@using T4Dungeon.Game.Core
@using RedTowerAdventure.Web

<div id="terminal-container"></div>

@code {
    private DotNetObjectReference<Home>? _dotNetRef;
    private TaskCompletionSource<ConsoleKeyInfo>? _inputWaiter;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("terminalInterop.init", _dotNetRef);

            Console.SetOut(new WebConsoleWriter(text =>
            {
                _ = JS.InvokeVoidAsync("terminalInterop.write", text.Replace("\n", "\r\n"));
            }));

            Console.SetIn(new WebConsoleReader(() =>
            {
                _inputWaiter = new TaskCompletionSource<ConsoleKeyInfo>();
                return _inputWaiter.Task;
            }));

            await Task.Yield();
            var engine = new GameEngine();
            engine.Run();
        }
    }

    [JSInvokable]
    public void OnTerminalInput(string data)
    {
        if (data.Length > 0)
        {
            var key = new ConsoleKeyInfo(data[0], ConsoleKey.A, false, false, false);
            _inputWaiter?.TrySetResult(key);
        }
    }
    private void OnTerminalKey(string keyData)
    {
        char c = keyData[0];
        // Convert the string key into a ConsoleKeyInfo and push it to the buffer
        var keyInfo = new ConsoleKeyInfo(c, ConsoleKey.NoName, false, false, false);
        InputManager.WebInputBuffer.Enqueue(keyInfo);
    }

    public void Dispose() => _dotNetRef?.Dispose();
}